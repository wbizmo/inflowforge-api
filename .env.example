PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://inflowforge:inflowforge_password@localhost:5432/inflowforge_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Browser origins. Production fails closed if this is empty.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# External webhook authentication. Use at least 32 random characters in production.
WEBHOOK_TRIGGER_SECRET=replace_with_a_cryptographically_random_secret_at_least_32_chars

# Admin API
ADMIN_TOKEN=change_this_admin_token

# Resend email action
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Telegram action
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_bot_chat_id
