PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://inflowforge:inflowforge_password@localhost:5432/inflowforge_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin API
ADMIN_TOKEN=change_this_admin_token

# Resend email action
# Create a free Resend account and generate an API key.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Telegram action
# Create a bot with @BotFather, send /start to it, then get chat_id from getUpdates.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_bot_chat_id